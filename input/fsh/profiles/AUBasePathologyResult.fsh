Profile: AUBasePathologyResult
Parent: Observation
Id: au-pathologyresult
Title: "AU Base Pathology Result"
Description: """This profile defines an observation structure to represent a pathology test result issued by a diagnostic service provider in an Australian context. This profile is intended to be capable of supporting reporting for all pathology disciplines (e.g. including microbiology, histopathology, cytology, blood transfusion) with the exception of genomics. The observation may represent the result of a simple test such as haemoglobin or it may group the set of results produced by a multi-test study or panel such as a full blood count, or urine specimen study.

This profile does not provide full support for structured pathology reporting. It is expected that this support is best handled by a set of profiles that represent the structured reporting requirements for each specific protocol (see for example [RCPA’s structured pathology reporting of cancer](https://www.rcpa.edu.au/Library/Practising-Pathology/Structured-Pathology-Reporting-of-Cancer)); this is not in the scope of this implementation guide at this time."""
* ^extension.url = "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
* ^extension.valueInteger = 1
* . ^short = "A pathology test result in an Australian healthcare context"
* . ^definition = "A pathology test result for a patient. This observation may be a simple test or a panel/study."
// WARNING: The constraint index in the following rule (e.g., constraint[0]) may be incorrect.
// Please compare with the constraint array in the original definition's snapshot and adjust as necessary.
* . ^constraint.key = "inv-obs-0"
* . ^constraint[0].source = "http://hl7.org.au/fhir/StructureDefinition/au-pathologyresult"
// WARNING: The constraint index in the following rule (e.g., constraint[0]) may be incorrect.
// Please compare with the constraint array in the original definition's snapshot and adjust as necessary.
* . ^constraint.severity = #error
// WARNING: The constraint index in the following rule (e.g., constraint[0]) may be incorrect.
// Please compare with the constraint array in the original definition's snapshot and adjust as necessary.
* . ^constraint.human = "A pathology result shall at least have value or data absent reason or a child observation with a value or data absent reason"
// WARNING: The constraint index in the following rule (e.g., constraint[0]) may be incorrect.
// Please compare with the constraint array in the original definition's snapshot and adjust as necessary.
* . ^constraint.expression = "value.exists() or dataAbsentReason.exists() or hasMember.exists() or component.value.exists() or component.dataAbsentReason.exists()"
* category ^slicing.discriminator[0].type = #value
* category ^slicing.discriminator[=].path = "coding.system"
* category ^slicing.discriminator[+].type = #value
* category ^slicing.discriminator[=].path = "coding.code"
* category ^slicing.rules = #open
* category ^short = "Classification of the service requested as laboratory + more specific discipline where available"
* category ^comment = "A fixed category denoting a laboratory service identifies the type of observation and supports handling and searching of observations. A second category to provide a finer grain of discipline, e.g. Haematology should be provided if possible."
* category contains
    lab 1..1 and
    specificDiscipline 0..*
* category[lab] ^short = "Observation generated by laboratories"
* category[lab].coding 1..
* category[lab].coding.system 1..
* category[lab].coding.system = "http://terminology.hl7.org/CodeSystem/observation-category" (exactly)
* category[lab].coding.code 1..
* category[lab].coding.code = #laboratory (exactly)
* category[specificDiscipline] from $pathology-diagnostic-service-category-1 (extensible)
* category[specificDiscipline] ^short = "Specific discipline of pathology"
* category[specificDiscipline].coding.system 1..
* category[specificDiscipline].coding.system = "http://terminology.hl7.org/CodeSystem/v2-0074" (exactly)
* code from $spia-pathology-reporting-1 (preferred)
* code ^short = "Pathology test or test group"
* code ^binding.extension[0].extension[0].url = "key"
* code ^binding.extension[=].extension[=].valueId = "adb-obs-chem-comp"
* code ^binding.extension[=].extension[+].url = "purpose"
* code ^binding.extension[=].extension[=].valueCode = #component
* code ^binding.extension[=].extension[+].url = "valueSet"
* code ^binding.extension[=].extension[=].valueCanonical = "https://www.rcpa.edu.au/fhir/ValueSet/spia-chemical-pathology-refset-3"
* code ^binding.extension[=].extension[+].url = "documentation"
* code ^binding.extension[=].extension[=].valueMarkdown = "This component value set (i.e. subset of the element binding) is for use when reporting chemical pathology results in Australia."
* code ^binding.extension[=].url = "http://hl7.org/fhir/tools/StructureDefinition/additional-binding"
* code ^binding.extension[+].extension[0].url = "key"
* code ^binding.extension[=].extension[=].valueId = "adb-obs-haem-comp"
* code ^binding.extension[=].extension[+].url = "purpose"
* code ^binding.extension[=].extension[=].valueCode = #component
* code ^binding.extension[=].extension[+].url = "valueSet"
* code ^binding.extension[=].extension[=].valueCanonical = "https://www.rcpa.edu.au/fhir/ValueSet/spia-haematology-refset-3"
* code ^binding.extension[=].extension[+].url = "documentation"
* code ^binding.extension[=].extension[=].valueMarkdown = "This component value set (i.e. subset of the element binding) is for use when for reporting haematology pathology results in Australia."
* code ^binding.extension[=].url = "http://hl7.org/fhir/tools/StructureDefinition/additional-binding"
* code ^binding.extension[+].extension[0].url = "key"
* code ^binding.extension[=].extension[=].valueId = "adb-obs-immuno-comp"
* code ^binding.extension[=].extension[+].url = "purpose"
* code ^binding.extension[=].extension[=].valueCode = #component
* code ^binding.extension[=].extension[+].url = "valueSet"
* code ^binding.extension[=].extension[=].valueCanonical = "https://www.rcpa.edu.au/fhir/ValueSet/spia-immunopathology-refset-3"
* code ^binding.extension[=].extension[+].url = "documentation"
* code ^binding.extension[=].extension[=].valueMarkdown = "This component value set (i.e. subset of the element binding) is for use when for reporting immunopathology pathology results in Australia."
* code ^binding.extension[=].url = "http://hl7.org/fhir/tools/StructureDefinition/additional-binding"
* code ^binding.extension[+].extension[0].url = "key"
* code ^binding.extension[=].extension[=].valueId = "adb-obs-micro-ser-mol-comp"
* code ^binding.extension[=].extension[+].url = "purpose"
* code ^binding.extension[=].extension[=].valueCode = #component
* code ^binding.extension[=].extension[+].url = "valueSet"
* code ^binding.extension[=].extension[=].valueCanonical = "https://www.rcpa.edu.au/fhir/ValueSet/spia-microbiology-serology-molecular-refset-3"
* code ^binding.extension[=].extension[+].url = "documentation"
* code ^binding.extension[=].extension[=].valueMarkdown = "This component value set (i.e. subset of the element binding) is for use when for reporting microbiology pathology results in Australia."
* code ^binding.extension[=].url = "http://hl7.org/fhir/tools/StructureDefinition/additional-binding"
* subject 1..
* subject only Reference(Patient)
* effective[x] 1..
* effective[x] ^short = "Time of specimen collection"
* value[x] ^condition = "inv-obs-0"
* dataAbsentReason ^condition = "inv-obs-0"
* specimen only Reference(AUBaseSpecimen)
* hasMember only Reference(AUBaseDiagnosticResult or AUBasePathologyResult)
* hasMember ^short = "Individual tests in a group or panel"
* hasMember ^condition = "inv-obs-0"
* component ^short = "Individual tests in a group or panel"
* component.code from $spia-pathology-reporting-1 (preferred)
* component.code ^short = "Individual pathology test"
* component.value[x] ^condition = "inv-obs-0"
* component.dataAbsentReason ^condition = "inv-obs-0"
