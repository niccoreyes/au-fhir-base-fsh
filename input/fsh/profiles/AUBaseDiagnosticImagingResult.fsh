Profile: AUBaseDiagnosticImagingResult
Parent: Observation
Id: au-imagingresult
Title: "AU Base Diagnostic Imaging Result"
Description: "This profile defines an observation structure to represent a imaging examination result issued by a diagnostic service provider in an Australian context. The observation may represent the conclusions of a diagnostic procedure such as Left retina Foveal thickness by OCT, or it may group the set of results produced by a multi-test study or panel such as Biophysical profile panel."
* ^extension.url = "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
* ^extension.valueInteger = 1
* obeys inv-obs-1
* . ^short = "A imaging examination result in an Australian healthcare context"
* . ^definition = "A diagnostic imaging examination result for a patient. This observation may be a simple examination or a study series."
// WARNING: The constraint index in the following rule (e.g., constraint[0]) may be incorrect.
// Please compare with the constraint array in the original definition's snapshot and adjust as necessary.
* . ^constraint.key = "inv-obs-0"
* . ^constraint[0].source = "http://hl7.org.au/fhir/StructureDefinition/au-imagingresult"
// WARNING: The constraint index in the following rule (e.g., constraint[0]) may be incorrect.
// Please compare with the constraint array in the original definition's snapshot and adjust as necessary.
* . ^constraint.severity = #error
// WARNING: The constraint index in the following rule (e.g., constraint[0]) may be incorrect.
// Please compare with the constraint array in the original definition's snapshot and adjust as necessary.
* . ^constraint.human = "An imaging result shall at least have value or data absent reason or a child observation with a value or data absent reason"
// WARNING: The constraint index in the following rule (e.g., constraint[0]) may be incorrect.
// Please compare with the constraint array in the original definition's snapshot and adjust as necessary.
* . ^constraint.expression = "value.exists() or dataAbsentReason.exists() or hasMember.exists() or component.value.exists() or component.dataAbsentReason.exists()"
* extension ^slicing.discriminator[0].type = #value
* extension ^slicing.discriminator[=].path = "url"
* extension ^slicing.rules = #open
* extension contains BodyStructureReference named bodyStructure 0..1
* extension[bodyStructure] ^condition = "inv-obs-1"
* category ^slicing.discriminator[0].type = #value
* category ^slicing.discriminator[=].path = "coding.system"
* category ^slicing.discriminator[+].type = #value
* category ^slicing.discriminator[=].path = "coding.code"
* category ^slicing.rules = #open
* category ^short = "Relevant diagnostic imaging category: service, modality and anatomic region"
* category ^comment = "A category denoting diagnostic imaging service identifies the type of report and supports macro handling of requests is required. A second category to provide the modality should be provided where possible; a value set to support this categorisation is not yet available. A third category to provide the anatomic region of interest should be provided where possible."
* category contains
    diagImg 1..1 and
    anatomicRegionOfInterest 0..*
* category[diagImg] ^short = "Observation generated by imaging"
* category[diagImg].coding 1..
* category[diagImg].coding.system 1..
* category[diagImg].coding.system = "http://terminology.hl7.org/CodeSystem/observation-category" (exactly)
* category[diagImg].coding.code 1..
* category[diagImg].coding.code = #imaging (exactly)
* category[anatomicRegionOfInterest] from $imaging-anatomic-region-of-interest-1 (extensible)
* category[anatomicRegionOfInterest] ^short = "Anatomic Region Of Interest"
* category[anatomicRegionOfInterest].coding.system 1..
* category[anatomicRegionOfInterest].coding.system = "http://snomed.info/sct" (exactly)
* code from $imaging-procedure-1 (preferred)
* code ^short = "Diagnostic imaging examination or study"
* subject 1..
* subject only Reference(Patient)
* effective[x] 1..
* effective[x] ^short = "Time of diagnostic imaging examination"
* value[x] ^condition = "inv-obs-0"
* dataAbsentReason ^condition = "inv-obs-0"
* bodySite from $body-site-1 (preferred)
* bodySite ^condition = "inv-obs-1"
* hasMember only Reference(AUBaseDiagnosticResult or AUBaseDiagnosticImagingResult)
* hasMember ^short = "Individual examinations in a group or study series"
* hasMember ^condition = "inv-obs-0"
* component ^short = "Individual examinations in a group or study series"
* component.code from $imaging-procedure-1 (preferred)
* component.code ^short = "Diagnostic imaging examination or study"
* component.value[x] ^condition = "inv-obs-0"
* component.dataAbsentReason ^condition = "inv-obs-0"
