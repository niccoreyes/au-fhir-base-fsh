Instance: example3-of-AUBaseLocation
InstanceOf: AUBaseLocation
Usage: #example
* id = "example3"
* status = #active
* type = $v3-RoleCode#FMC "Family medicine clinic"
* address.type = #physical
* address.line = "55 Sandy Bay Road"
* address.city = "Strahan"
* address.state = "TAS"
* address.postalCode = "7468"
* address.country = "AU"
* physicalType = $location-physical-type_1#bu "Building"