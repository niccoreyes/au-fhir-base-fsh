Instance: example1-of-AUBaseLocation
InstanceOf: AUBaseLocation
Usage: #example
* id = "example1"
* status = #active
* address.use = #work
* address.line = "33 Slobodian Street"
* address.city = "Albion"
* address.state = "QLD"
* address.postalCode = "4010"
* address.country = "AU"
* physicalType = $location-physical-type_1#si "Site"