* address.line = "700 Church Road"
* address.city = "Zillmere"
* address.state = "QLD"
* address.postalCode = "4034"
* address.country = "AU"
* physicalType = $location-physical-type_1#si
* physicalType.text = "Site"
* managingOrganization = Reference(Organization/example5)